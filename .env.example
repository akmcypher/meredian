# Copy to .env and fill in. Never commit .env.
# Values for a local stack come from `supabase status` after `supabase start`.

# Browser (public) settings
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Show "Continue with Google" only once a Google OAuth client is configured in Supabase Auth.
VITE_AUTH_GOOGLE_ENABLED=false
# Supabase Auth (configured in config.toml locally / Auth settings when hosted):
# require email confirmation; allow the exact application /auth/callback and
# /auth/callback?flow=recovery URLs. Auth SMTP is separate from alert SMTP below.
# See docs/AUTHENTICATION.md before enabling public registration.

# Server settings (same project)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs short-lived tokens for engines that read published datasets (generate with
# `node scripts/engine-keys.mjs`; the public half goes to each engine). User sessions are never
# forwarded to engines.
ENGINE_TOKEN_SIGNING_KEY=

# Public key that verifies licence files, if you apply one. Nothing here depends on it.
MERIDIAN_LICENCE_PUBLIC_KEY=

# Email alerts (server only). Unset = alerts report "not configured". Any SMTP relay works.
# SMTP_SECURITY: starttls (default, port 587), tls (465) or none (local relays only).
# Local test relay: Mailpit from `supabase start` on 127.0.0.1:54325 (web UI 54324).
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
